# Base de datos Postgres (Neon). Vercel la agrega sola al conectar Neon desde Storage.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Clave gratuita de https://finnhub.io (precios de acciones y ETF)
FINNHUB_API_KEY=
# Contraseña para entrar a tu app
APP_PASSWORD=cambia-esto
# Secreto para el cron diario de Vercel (cualquier texto largo)
CRON_SECRET=
